{
  "expo": {
    "name": "Parkolj",
    "slug": "parkolj-budapest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hu.parkolj.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.hu.parkolj.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "hu.parkolj.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Parkolj – Budapest"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Parkolj a helyzetedből mutatja meg a zónát, az árat és a közeli parkolóhelyeket."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "A Parkolj arcazonosítással hagyja jóvá a nagyobb összegű fizetéseket."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A Parkolj a kiválasztott fotót menti el, hogy megtaláld, hol hagytad az autót. A fotó csak a telefonodon marad.",
          "cameraPermission": "A Parkolj fotót készít arról, hol hagytad az autót (pl. az oszlop jelzése a mélygarázsban). A fotó csak a telefonodon marad.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ParkolasWidget",
              "label": "Parkolásom",
              "description": "Aktív parkolás: zóna, lejárat, +15 perc, leállítás",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/parkolas-preview.png",
              "widgetCategory": "home_screen|keyguard"
            },
            {
              "name": "GyorsWidget",
              "label": "Gyors indítás",
              "description": "Parkolás itt, Otthon, Munkahely egy koppintással",
              "minWidth": "250dp",
              "minHeight": "70dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeHeight": "160dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/gyors-preview.png"
            }
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "baseUrl": "/parkolj"
    },
    "scheme": "parkolj",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7F9"
    }
  }
}
