{
  "expo": {
    "name": "Parkolj",
    "slug": "parkolj-budapest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hu.parkolj.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "hu.parkolj.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Parkolj – Budapest"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Parkolj a helyzetedből mutatja meg a zónát, az árat és a közeli parkolóhelyeket."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "A Parkolj arcazonosítással hagyja jóvá a nagyobb összegű fizetéseket."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/parkolj"
    },
    "scheme": "parkolj",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7F9"
    }
  }
}
