{
  "name": "parkolj-server",
  "version": "1.0.0",
  "description": "Parkolj API (Cloudflare Workers + Supabase)",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "TZ=UTC tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:check": "wrangler deploy --dry-run --outdir dist",
    "test": "TZ=UTC node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "hono": "^4.13.19",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.166.0"
  },
  "private": true
}
